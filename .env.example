# Copy to .env for local use. Set production values in Vercel Project Settings.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HeartConnect Global <no-reply@example.com>

# From Cloudinary Console > API Environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
